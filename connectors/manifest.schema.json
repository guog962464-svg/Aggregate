{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aggregate.local/schemas/connector-manifest-v1.json",
  "title": "Aggregate CLI connector manifest v1",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "platforms", "executable", "actions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "displayName": {"type": "string", "minLength": 1},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["macos", "windows", "linux", "android", "ios", "web"]}
    },
    "executable": {"type": "string", "minLength": 1},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "argv", "inputSchema", "output", "permission", "timeoutMs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "inputSchema": {"type": "object", "required": ["type", "properties"], "properties": {"type": {"const": "object"}, "properties": {"type": "object"}, "required": {"type": "array", "items": {"type": "string"}}}},
          "output": {"enum": ["text", "json", "file", "terminal"]},
          "permission": {"enum": ["read", "localControl", "externalWrite", "unknown"]},
          "presentation": {"enum": ["music.search", "music.play", "music.pause", "music.resume", "music.stop", "music.next", "music.prev", "music.volume", "music.state"]},
          "timeoutMs": {"type": "integer", "minimum": 100, "maximum": 3600000}
        }
      }
    }
  }
}
